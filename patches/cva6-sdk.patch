diff --git a/rootfs/etc/init.d/S99custom_procs b/rootfs/etc/init.d/S99custom_procs
new file mode 100755
index 0000000..55c8e10
--- /dev/null
+++ b/rootfs/etc/init.d/S99custom_procs
@@ -0,0 +1,14 @@
+#!/bin/sh
+start() {
+    /usr/bin/proc1 > /var/log/proc1.log 2>&1 &
+    /usr/bin/proc2 > /var/log/proc2.log 2>&1 &
+}
+stop() {
+    killall proc1 proc2
+}
+case "$1" in
+  start) start ;;
+  stop) stop ;;
+  restart) stop; start ;;
+  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
+esac
\ No newline at end of file
