diff --git a/include/boards/cheshire.h b/include/boards/cheshire.h
new file mode 100644
index 0000000..823ba89
--- /dev/null
+++ b/include/boards/cheshire.h
@@ -0,0 +1,54 @@
+/*
+* This file defines the Cheshire (CVA6) SoC board macros for SACTV
+*
+* Copyright (C) 2026 Emanuele Aquilia <s337181@studenti.polito.it>
+*
+*/
+
+#ifndef __CHESHIRE_BOARD_H
+#define __CHESHIRE_BOARD_H
+
+/* CONSTANTS */
+
+/* Board-specific constants */
+#define CACHE_LINE      64 // 64B cache block
+#define L1_CACHE_LINE   16 // 16B cache block for L1 D-Cache
+#define L2_CACHE_LINE   64 // 64B cache block for L2 LLC
+
+#define L1_CACHE_SIZE   32*1024 // 32 KiB L1 D-Cache
+#define L1_ASSOC        8       // 8-way associative
+
+#define L2_CACHE_SIZE   128*1024 // 128 KiB LLC (Last Level Cache)
+#define L2_ASSOC        8        // 8-way associative
+
+#define NO_L3_CACHE
+#define NO_FLUSH
+#define SINGLE_CORE
+
+/* Eviction strategy parameters */
+#define L1_C 4
+#define L1_S L1_ASSOC+2
+#define L1_D L1_S-1
+#define L1_L 1
+
+#define L2_C 4
+#define L2_S L2_ASSOC+2
+#define L2_D L2_S-1
+#define L2_L 1
+
+/* CPU definitions (single core, so everything is core 0) */
+#define LOCAL_CPU1  0
+#define LOCAL_CPU2  0
+#define REMOTE_CPU1 0
+#define REMOTE_CPU2 0
+#define REST_CPU    0
+
+/* Board-specific inline instructions */
+__attribute__((always_inline))
+static inline void flush(size_t char_ptr)
+{
+    // NO_FLUSH is defined, so standard flush instruction is bypassed.
+    (void)char_ptr;
+}
+
+#endif // !__CHESHIRE_BOARD_H
